# Katedra uses the existing production Lekta Supabase as the single Academic Suite backend.
# Project ref: zrrjttizjyfcxmcpgzml
NEXT_PUBLIC_SUPABASE_URL=https://zrrjttizjyfcxmcpgzml.supabase.co

# Public client key from the canonical Lekta Supabase project.
# Publishable keys are intentionally safe for browser/client use.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_D6JdPH6dVamBr2NAGqYu1A_Gy0MlNaM

# Server-only. Copy from the SAME Lekta Supabase project into the deployment
# provider's protected environment. Never expose this through NEXT_PUBLIC_* and
# never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_DEPLOYMENT_SECRET_STORE

# Existing Katedra application secrets/configuration.
ANTHROPIC_API_KEY=REPLACE_IN_DEPLOYMENT_SECRET_STORE
# Set true only after the approved Anthropic vision path is tested in staging.
KATEDRA_ANTHROPIC_VISION_ENABLED=false
# Optional server-side web research gateway. Keep empty until its policy and
# source-verification contract are approved in staging.
KATEDRA_RESEARCH_PROVIDER_URL=
KATEDRA_RESEARCH_PROVIDER_KEY=REPLACE_IN_DEPLOYMENT_SECRET_STORE
KATEDRA_RESEARCH_PROVIDER_MODEL=REPLACE_WITH_APPROVED_RESEARCH_MODEL
KATEDRA_RESEARCH_POLICY_APPROVED=false
# Must be set to v2 only after the idempotent katedra_consume contract from
# docs/architecture/KATEDRA_BILLING_RPC_CONTRACT.md is deployed in Lekta.
KATEDRA_BILLING_RPC_CONTRACT=v2
# Required in production. The only implemented adapter is `supabase`, meaning
# the atomic Lekta-side reservation contract is deployed. Other values fail
# closed until a matching adapter is implemented.
KATEDRA_RATE_LIMIT_STORE=supabase
STRIPE_SECRET_KEY=REPLACE_IN_DEPLOYMENT_SECRET_STORE
STRIPE_WEBHOOK_SECRET=REPLACE_IN_DEPLOYMENT_SECRET_STORE

# Server-only. Required for production withdrawal confirmation emails.
RESEND_API_KEY=REPLACE_IN_DEPLOYMENT_SECRET_STORE

# Server-side sender identity. Must be a verified production-domain address.
# Do not use onboarding@resend.dev in production.
WITHDRAWAL_FROM_EMAIL=REPLACE_WITH_VERIFIED_SENDER_ADDRESS

# Project locks are required for any production Pass checkout. Keep them
# disabled locally until the matching Lekta contract is deployed and verified.
# Agentic workflow flags remain disabled until their additional staging gate
# passes.
KATEDRA_PROJECT_LOCKS_ENABLED=false
KATEDRA_AGENT_RUNS_ENABLED=false
KATEDRA_MATERIALS_ENABLED=false
# Set to v1 only after Lekta's tombstone_agent_payload RPC and its staging
# deletion test are deployed. DELETE remains fail-closed when unset.
KATEDRA_MATERIAL_DELETE_RPC_CONTRACT=
KATEDRA_TEMP_MATERIALS_BUCKET=katedra-temporary-materials
KATEDRA_AGENT_MODEL=REPLACE_WITH_APPROVED_PROVIDER_MODEL
# Required only when KATEDRA_AGENT_RUNS_ENABLED=true. Must be an HTTPS
# endpoint for the canonical Lekta worker dispatcher.
KATEDRA_WORKER_APP_URL=REPLACE_WITH_HTTPS_WORKER_APP_URL
# Required only when KATEDRA_AGENT_RUNS_ENABLED=true. Keep the same secret in
# the Katedra app and Lekta worker dispatcher; never expose it client-side.
KATEDRA_AGENT_WORKER_TOKEN=REPLACE_IN_DEPLOYMENT_SECRET_STORE
# Required only when KATEDRA_AGENT_RUNS_ENABLED=true. Used to authenticate
# scheduled worker dispatch; never expose it client-side.
KATEDRA_AGENT_WORKER_CRON_SECRET=REPLACE_IN_DEPLOYMENT_SECRET_STORE

# Current production origin on Netlify. Replace only when a custom domain is promoted.
NEXT_PUBLIC_APP_URL=https://katedra.netlify.app

# Server-side support override for one explicitly confirmed account. Keep
# disabled by default and configure the exact email in the deployment secret
# store. This does not create a Stripe Pass or modify Lekta entitlements.
KATEDRA_ADMIN_OVERRIDE_ENABLED=false
KATEDRA_ADMIN_EMAILS=danielrisavi77@gmail.com
