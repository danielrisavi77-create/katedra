# Katedra uses the existing production Lekta Supabase as the single Academic Suite backend.
# Project ref: zrrjttizjyfcxmcpgzml
NEXT_PUBLIC_SUPABASE_URL=https://zrrjttizjyfcxmcpgzml.supabase.co

# Public client key from the canonical Lekta Supabase project.
# Publishable keys are intentionally safe for browser/client use.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_D6JdPH6dVamBr2NAGqYu1A_Gy0MlNaM

# Server-only. Copy from the SAME Lekta Supabase project into the deployment
# provider's protected environment. Never expose this through NEXT_PUBLIC_* and
# never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_DEPLOYMENT_SECRET_STORE

# Existing Katedra application secrets/configuration.
ANTHROPIC_API_KEY=REPLACE_IN_DEPLOYMENT_SECRET_STORE
STRIPE_SECRET_KEY=REPLACE_IN_DEPLOYMENT_SECRET_STORE
STRIPE_WEBHOOK_SECRET=REPLACE_IN_DEPLOYMENT_SECRET_STORE

# Current production origin on Netlify. Replace only when a custom domain is promoted.
NEXT_PUBLIC_APP_URL=https://katedra.netlify.app
